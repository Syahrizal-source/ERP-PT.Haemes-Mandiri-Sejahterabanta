+
+  const filteredOptions = options.filter((coa) => {
+    const searchableText = `${coa.kode} ${coa.nama}`.toLocaleLowerCase("id-ID");
+
+    return searchableText.includes(normalizedSearch);
+  });
+
+  function selectCoa(coaId: number): void {
+    onChange(coaId);
+
+    setSearch("");
