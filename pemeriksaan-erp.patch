+  summary.getCell("A5").value =
+    `Rentang transaksi: ${formatDate(tanggalMulai)} s/d ${formatDate(tanggalSelesai)}`;
+  summary.getCell("A6").value = `Tanggal cetak: ${new Date().toLocaleDateString("id-ID")}`;
+  summary.getCell("A7").value = "Sumber: public.v_buku_besar_ekuitas_per_akun (jurnal POSTED)";
+
+  const headers = [
+    "Kode COA", "Nama Akun", "Saldo Normal", "Saldo Awal",
+    "Total Debit", "Total Kredit", "Saldo Akhir",
+  ];
+  summary.getRow(9).values = headers;
+  for (let col = 1; col <= headers.length; col++) styleHeader(summary.getCell(9, col));
+
+  let rowIndex = 10;
+  for (const account of accounts) {
+    const row = summary.getRow(rowIndex);
+    row.values = [
+      account.kode_coa,
+      account.nama_coa,
+      account.normal_balance,
+      account.saldo_awal,
