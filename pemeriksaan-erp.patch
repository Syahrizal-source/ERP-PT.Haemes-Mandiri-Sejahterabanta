+
+    pattern: "solid",
+
+    fgColor: { argb: "FFF4CCCC" },
+  };
+
+  border(cell);
+}
+
+function styleSection(cell: ExcelJS.Cell): void {
+  cell.font = { bold: true, size: 12 };
+
+  cell.fill = {
+    type: "pattern",
+
+    pattern: "solid",
+
+    fgColor: { argb: "FFD9EAD3" },
+  };
+
+  border(cell);
+}
+
+function styleTotal(cell: ExcelJS.Cell): void {
+  cell.font = { bold: true };
+
+  cell.fill = {
+    type: "pattern",
+
+    pattern: "solid",
+
+    fgColor: { argb: "FFD9D9D9" },
