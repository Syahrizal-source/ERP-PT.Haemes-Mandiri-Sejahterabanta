+    detail.getCell("A7").numFmt = ACCOUNTING_FORMAT;
+
+    const detailHeaders = [
+      "Tanggal",
+      "Voucher",
+      "Keterangan",
+      "Debit",
+      "Kredit",
+      "Saldo Berjalan",
