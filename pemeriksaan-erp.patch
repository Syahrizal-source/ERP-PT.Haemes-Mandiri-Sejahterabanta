+export async function GET(request: Request): Promise<Response> {
+  try {
+    const url = new URL(request.url);
+    const { data: periodData, error: periodError } = await db
+      .from("periode")
+      .select(
+        "id_periode, nama_periode, status, tanggal_mulai, tanggal_selesai, is_closed",
+      )
+      .eq("status", "OPEN")
+      .eq("is_closed", false)
+      .order("tanggal_mulai", { ascending: false })
+      .limit(1);
+
+    if (periodError) {
+      return NextResponse.json(
+        { error: `Gagal mengambil periode OPEN: ${periodError.message}` },
+        { status: 500 },
+      );
+    }
+
+    const periods = (periodData ?? []) as PeriodeRow[];
+    const openPeriod = periods[0];
+    if (!openPeriod) {
+      return NextResponse.json(
+        {
+          error:
+            "Periode OPEN tidak ditemukan untuk menentukan rentang laporan.",
+        },
+        { status: 409 },
+      );
+    }
+
+    if (
+      !isValidDate(openPeriod.tanggal_mulai) ||
+      !isValidDate(openPeriod.tanggal_selesai)
+    ) {
+      return NextResponse.json(
+        { error: `Tanggal periode ${openPeriod.nama_periode} tidak valid.` },
+        { status: 422 },
+      );
+    }
+
+    const startParam = url.searchParams.get("tanggal_mulai")?.trim();
+    const endParam = url.searchParams.get("tanggal_selesai")?.trim();
+    if (
+      (startParam && !isValidDate(startParam)) ||
+      (endParam && !isValidDate(endParam))
+    ) {
+      return NextResponse.json(
+        { error: "Format tanggal harus YYYY-MM-DD." },
+        { status: 400 },
+      );
+    }
+
+    const tanggalMulai = startParam || openPeriod.tanggal_mulai;
+    const tanggalSelesai = endParam || openPeriod.tanggal_selesai;
+    if (tanggalMulai > tanggalSelesai) {
+      return NextResponse.json(
+        {
+          error: "Tanggal mulai tidak boleh lebih besar dari tanggal selesai.",
+        },
+        { status: 400 },
+      );
+    }
+
+    const allRows = await fetchBankRows(tanggalSelesai);
+    const accounts = buildAccounts(allRows, tanggalMulai);
+    const totals = getTotals(accounts);
+    const mode = normalizeText(url.searchParams.get("mode"));
+
+    if (mode === "VIEW" || mode === "PREVIEW" || mode === "JSON") {
+      return NextResponse.json(
+        {
+          success: true,
+          report: "BUKU_BESAR_BANK",
+          company: COMPANY_NAME,
+          periode: {
+            id_periode: openPeriod.id_periode,
+            nama_periode: openPeriod.nama_periode,
+            status: openPeriod.status,
+            tanggal_mulai: tanggalMulai,
+            tanggal_selesai: tanggalSelesai,
+          },
+          generated_at: new Date().toISOString(),
+          currency: "IDR",
+          totals,
+          accounts,
+          metadata: {
+            sumber_data: `public.${VIEW_NAME}`,
+            status_jurnal: "POSTED",
+            jumlah_baris_sumber_sampai_tanggal_akhir: allRows.length,
+            jumlah_akun: accounts.length,
+            jumlah_detail_periode: totals.jumlah_detail,
+            catatan_saldo:
+              "Saldo awal diambil dari saldo_berjalan terakhir sebelum tanggal mulai; setiap saldo transaksi dan saldo akhir mengikuti saldo_berjalan dari view database.",
+          },
+        },
+        { status: 200, headers: { "Cache-Control": "no-store, max-age=0" } },
+      );
+    }
+
+    const workbook = createWorkbook(
+      accounts,
+      tanggalMulai,
+      tanggalSelesai,
+      openPeriod.nama_periode,
+    );
+    const buffer = await workbook.xlsx.writeBuffer();
+    return new Response(buffer, {
+      status: 200,
+      headers: {
+        "Content-Type":
+          "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
+        "Content-Disposition":
+          'attachment; filename="laporan-buku-besar-bank.xlsx"',
+        "Cache-Control": "no-store, max-age=0",
+      },
+    });
+  } catch (error: unknown) {
+    console.error("REPORT BUKU BESAR BANK API ERROR:", error);
+    return NextResponse.json(
+      {
+        error:
+          error instanceof Error
+            ? error.message
+            : "Gagal membuat laporan Buku Besar Bank.",
+      },
+      { status: 500 },
+    );
+  }
+}
